# ========================================================================
# NASQ ABSENSI - ENVIRONMENT CONFIGURATION
# ========================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- SUPABASE CONFIGURATION (Recommended for Vercel / Client-Side) ---
# Dapatkan dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- SUPABASE / POSTGRESQL DIRECT DATABASE URL (For server.ts backend) ---
# Dapatkan dari Supabase Dashboard > Project Settings > Database > Connection String (URI / Session / Transaction)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
